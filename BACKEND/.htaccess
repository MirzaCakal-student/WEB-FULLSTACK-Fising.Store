RewriteEngine On
RewriteBase /WEB-FULLSTACK-Fising.Store/BACKEND/

# Pass Authorization header to PHP (multiple methods for compatibility)
RewriteCond %{HTTP:Authorization} .+
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# If the request is for a real file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Otherwise, forward everything to index.php
RewriteRule ^(.+)$ index.php [QSA,L]